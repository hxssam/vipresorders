        ".read": "auth != null && (auth.token.email == 'admin@vip.local' || auth.token.email == 'bot@vip.local' || (auth.token.email == 'viewer@vip.local' && root.child('access').child('obs').child('on').val() != 0) || root.child('ok').child(auth.uid).exists())"
      }
    },
    "access": {
      ".read": "auth != null && (auth.token.email == 'admin@vip.local' || auth.token.email == 'bot@vip.local' || (auth.token.email == 'viewer@vip.local' && root.child('access').child('obs').child('on').val() != 0) || root.child('ok').child(auth.uid).exists())",
      "obs": {
        ".write": "auth != null && auth.token.email == 'admin@vip.local'",
        ".validate": "newData.hasChildren(['on'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "on": {
          ".validate": "newData.isNumber()"
        },
        "mode": {
          ".validate": "newData.val() == 'view' || newData.val() == 'edit'"
        },
        "$other": {
          ".validate": false
        }
      },
      "ep": {
        ".write": "auth != null && auth.token.email == 'admin@vip.local'",
        ".validate": "newData.isNumber()"
      },
      "w": {
        ".write": "auth != null && (auth.token.email == 'admin@vip.local' || auth.token.email == 'bot@vip.local')",
        ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/[A-Za-z0-9.-]+$/)",
        ".read": true
      },
      "ge": {
        ".write": "auth != null && auth.token.email == 'admin@vip.local'",
        ".validate": "newData.isNumber()"
      }
    },
    "proposals": {
      ".read": "auth != null && (auth.token.email == 'admin@vip.local' || auth.token.email == 'bot@vip.local' || auth.token.email == 'viewer@vip.local')",
      "$id": {
        ".write": "auth != null && (auth.token.email == 'admin@vip.local' || (auth.token.email == 'viewer@vip.local' && !data.exists()))",
        ".validate": "newData.hasChildren(['m','p','t'])",
        "m": {
          ".validate": "newData.val() == 'PUT' || newData.val() == 'PATCH' || newData.val() == 'DELETE'"
        },
        "p": {
          ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^(prep|prepMeta|prepLibrary|prepPins|writeoffs|plan|orders|receipts|catalog|prepCats)\\/.+/)"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "v": {
          ".validate": "newData.isString() && newData.val().length <= 30000"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "d": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "g": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "s": {
          ".validate": "newData.val() == 'ok' || newData.val() == 'no'"
        },
        "dt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "trash": {
      ".read": "auth != null && auth.token.email == 'admin@vip.local'",
      ".indexOn": [
        "t"
      ],
      "$id": {
        ".write": "(auth != null && (auth.token.email == 'admin@vip.local' || auth.token.email == 'bot@vip.local' || root.child('ok').child(auth.uid).exists())) && (!data.exists() || (auth != null && auth.token.email == 'admin@vip.local'))",
        ".validate": "newData.hasChildren(['p','t','v'])",
        "p": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "v": {
          ".validate": "newData.isString() && newData.val().length <= 100000"
        },
        "d": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "g": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "lk": {
      ".read": "auth != null && auth.token.email == 'admin@vip.local'",
      "$h": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'admin@vip.local'",
        ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{3,40}$/)"
      }
    },
    "ok": {
      ".read": "auth != null && auth.token.email == 'admin@vip.local'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'admin@vip.local')",
        ".write": "auth != null && auth.token.email == 'admin@vip.local'",
        ".validate": "newData.hasChildren(['id','n'])",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "r": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}