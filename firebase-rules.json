      ".read": "auth != null && (auth.token.email == 'admin@vip.local' || auth.token.email == 'bot@vip.local' || (auth.token.email == 'viewer@vip.local' && root.child('access').child('obs').child('on').val() != 0) || root.child('ok').child(auth.uid).exists())",
      ".write": "auth != null && auth.token.email == 'admin@vip.local'",
      "$dev": {
        ".write": "(auth != null && (auth.token.email == 'admin@vip.local' || auth.token.email == 'bot@vip.local' || root.child('ok').child(auth.uid).exists())) && ($dev.length <= 40)",
        "$k": {
          ".validate": "newData.hasChildren(['t', 'm']) && $k.length <= 20",
          "t": {
            ".validate": "newData.isNumber()"
          },
          "m": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "s": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "v": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "k": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "w": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "n": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "devices": {
      ".read": "auth != null && (auth.token.email == 'admin@vip.local' || auth.token.email == 'bot@vip.local')",
      ".write": "auth != null && auth.token.email == 'admin@vip.local'",
      "$dev": {
        ".write": "(auth != null && (auth.token.email == 'admin@vip.local' || auth.token.email == 'bot@vip.local' || root.child('ok').child(auth.uid).exists())) && ($dev.length <= 40)",
        ".validate": "newData.hasChildren(['t', 'v'])",
        "t": {
          ".validate": "newData.isNumber()"
        },
        "v": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "q": {
          ".validate": "newData.isNumber()"
        },
        "u": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "c": {
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
