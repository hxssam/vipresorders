{
  "rules": {
    "team": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@vip.local'"
    },
    "catalog": {
      ".read": true,
      "edits": {
        ".write": "auth != null && auth.token.email == 'admin@vip.local'"
      },
      "hidden": {
        ".write": "auth != null && auth.token.email == 'admin@vip.local'"
      },
      "custom": {
        "$id": {
          ".write": "!data.exists() || (auth != null && auth.token.email == 'admin@vip.local')"
        }
      },
      "groups": {
        "$id": {
          ".write": "!data.exists() || (auth != null && auth.token.email == 'admin@vip.local')"
        }
      }
    },
    "orders": {
      ".read": true,
      ".indexOn": [
        "created"
      ],
      "$id": {
        ".write": "!data.exists() || newData.exists() || (auth != null && auth.token.email == 'admin@vip.local')"
      }
    },
    "prep": {
      ".read": true,
      "$date": {
        "$id": {
          ".write": true
        }
      }
    },
    "prepMeta": {
      ".read": true,
      "$date": {
        ".write": true
      }
    },
    "prepLibrary": {
      ".read": true,
      ".write": true
    },
    "prepPins": {
      ".read": true,
      ".write": true
    },
    "writeoffs": {
      ".read": true,
      "$date": {
        "$id": {
          ".write": true
        }
      }
    },
    "plan": {
      ".read": true,
      ".write": true
    },
    "sched": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@vip.local'"
    },
    "shifts": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@vip.local'"
    },
    "meta": {
      ".read": true,
      ".write": true
    },
    "payroll": {
      ".read": "auth != null && auth.token.email == 'admin@vip.local'",
      ".write": "auth != null && auth.token.email == 'admin@vip.local'"
    },
    "acct": {
      "$key": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'admin@vip.local'"
      }
    }
  }
}