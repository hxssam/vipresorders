    "acct": {
      "$key": {
        ".read": "auth != null && (auth.token.email == 'admin@vip.local' || auth.token.email == 'bot@vip.local' || (auth.token.email == 'viewer@vip.local' && root.child('access').child('obs').child('on').val() != 0) || root.child('ok').child(auth.uid).exists())",
        ".write": "auth != null && auth.token.email == 'admin@vip.local'",
        "in": {
          "$date": {
            ".write": "(auth != null && (auth.token.email == 'admin@vip.local' || auth.token.email == 'bot@vip.local' || root.child('ok').child(auth.uid).exists())) && (root.child('acct').child($key).child('n').exists())",
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
            "h": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "rt": {
          "$id": {
            ".write": "(auth != null && (auth.token.email == 'admin@vip.local' || auth.token.email == 'bot@vip.local' || root.child('ok').child(auth.uid).exists())) && (root.child('acct').child($key).child('n').exists())",
            ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['f','r','t'])",
            "f": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "r": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "pm": {
          "$id": {
            ".write": "(auth != null && (auth.token.email == 'admin@vip.local' || auth.token.email == 'bot@vip.local' || root.child('ok').child(auth.uid).exists())) && (root.child('acct').child($key).child('n').exists())",
            ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['d','a','t','m'])",
            "d": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "a": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000"
            },
            "t": {
              ".validate": "newData.isString() && (newData.val() == 'adv' || newData.val() == 'sal' || newData.val() == 'oth')"
            },
            "m": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}$/)"
            },
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "w": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
