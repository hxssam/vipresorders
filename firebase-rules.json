{
  "rules": {
    "team": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@vip.local'"
    },
    "catalog": {
      ".read": true,
      "edits": {
        ".write": "auth != null && auth.token.email == 'admin@vip.local'"
      },
      "hidden": {
        ".write": "auth != null && auth.token.email == 'admin@vip.local'"
      },
      "custom": {
        "$id": {
          ".write": "!data.exists() || (auth != null && auth.token.email == 'admin@vip.local')"
        }
      },
      "groups": {
        "$id": {
          ".write": "!data.exists() || (auth != null && auth.token.email == 'admin@vip.local')",
          ".validate": "newData.hasChildren(['n'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "e": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "orders": {
      ".read": true,
      ".indexOn": [
        "created"
      ],
      "$id": {
        ".write": "!data.exists() || newData.exists() || (auth != null && auth.token.email == 'admin@vip.local')"
      }
    },
    "prep": {
      ".read": true,
      "$date": {
        "$id": {
          ".write": true
        }
      }
    },
    "prepMeta": {
      ".read": true,
      "$date": {
        ".write": true
      }
    },
    "prepLibrary": {
      ".read": true,
      ".write": true
    },
    "prepPins": {
      ".read": true,
      ".write": true
    },
    "writeoffs": {
      ".read": true,
      "$date": {
        "$id": {
          ".write": true
        }
      }
    },
    "plan": {
      ".read": true,
      ".write": true
    },
    "sched": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@vip.local'"
    },
    "shifts": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@vip.local'"
    },
    "meta": {
      ".read": true,
      ".write": true
    },
    "payroll": {
      ".read": "auth != null && auth.token.email == 'admin@vip.local'",
      ".write": "auth != null && auth.token.email == 'admin@vip.local'"
    },
    "acct": {
      "$key": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'admin@vip.local'",
        "in": {
          "$date": {
            ".write": "root.child('acct').child($key).child('n').exists()",
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
            "h": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "rt": {
          "$id": {
            ".write": "root.child('acct').child($key).child('n').exists()",
            ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['f','r','t'])",
            "f": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "r": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "pm": {
          "$id": {
            ".write": "root.child('acct').child($key).child('n').exists()",
            ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['d','a','t','m'])",
            "d": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "a": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000"
            },
            "t": {
              ".validate": "newData.isString() && (newData.val() == 'adv' || newData.val() == 'sal' || newData.val() == 'oth')"
            },
            "m": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}$/)"
            },
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "w": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "prepCats": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@vip.local'",
      "$id": {
        ".validate": "newData.hasChildren(['n'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "e": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "o": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}